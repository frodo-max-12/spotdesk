# SpotDesk configuration — copy to .env and fill in. Every value is overridable;
# the identity block below is what the agent signs outbound mail as.

# ── Identity ─────────────────────────────────────────────────────────
COMPANY_NAME=Your Company
COMPANY_ENTITY=Your Company Pte Ltd
COMPANY_TAGLINE=Singapore + India | 25+ years in business | ISO 9001:2015 | 50+ franchise lines + active spot desk
COMPANY_WEBSITE=www.example.com
QUOTE_PREFIX=YC
SIGNOFF_NAME=International Sales

AGENT_MAILBOX=sales@example.com
INTERNAL_DOMAINS=example.com
OVERSIGHT_CC=
TEST_EMAIL=you@example.com

# ── Gmail OAuth ──────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=config/credentials.json
GOOGLE_TOKEN_FILE=config/token.json

# ── LLM ──────────────────────────────────────────────────────────────
# anthropic = Messages API (production default) | claude_cli = local `claude` CLI (dev)
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
MODEL_LIGHT=claude-haiku-4-5-20251001
MODEL_HEAVY=claude-sonnet-5

# ── Behaviour ────────────────────────────────────────────────────────
# testing = drafts only, nothing external auto-sends. automatic = policies apply.
AGENT_MODE=testing
# Per-action policy: draft (human sends) | auto (send when gates pass, automatic mode only)
POLICY_ACK=draft
POLICY_VENDOR_RFQ=draft
POLICY_QUOTE=draft
POLICY_NEGOTIATION=draft
POLICY_PO_ACK=draft
POLICY_VENDOR_PO=draft
POLICY_FOLLOWUP=draft
POLICY_LOGISTICS=draft

POLL_INTERVAL_SECONDS=60
MONITOR_INTERVAL_SECONDS=120
# Never sweep mail older than this on startup backfill (YYYY/MM/DD). REQUIRED before
# first live run on a mailbox with history, or the whole inbox will be processed.
BACKFILL_FLOOR=
VENDOR_REPLY_WAIT_HOURS=24
DEAL_NO_RESPONSE_DAYS=21

# ── Sourcing / pricing ───────────────────────────────────────────────
VENDOR_MAX_PER_PART=8
CONSOLIDATION_LLM_PLANNING=true
DEFAULT_MARGIN_PERCENT=15
MARGIN_OVERRIDES=
DEFAULT_EXPENSES_PERCENT=3
MIN_MARGIN_PERCENT=8
NEGOTIATION_MIN_MARGIN_PERCENT=10
MAX_VENDOR_ASK_PERCENT=20
AUTO_SEND_MAX_VALUE=0

# ── Market lookup ────────────────────────────────────────────────────
MOUSER_API_KEY=
OEMSTRADE_ENABLED=true

# ── Circuit breakers ─────────────────────────────────────────────────
MAX_OUTBOUND_PER_DAY=300
MAX_COLD_SENDS_PER_DAY=300
BOUNCE_RATE_HALT_PCT=15

# ── Dashboard ────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_USER=
DASHBOARD_PASSWORD=
